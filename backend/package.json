    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^7.0.0",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.0",
    "csv-parse": "^5.4.1",
    "nodemailer": "^6.9.5",
    "twilio": "^3.93.0",
    "sharp": "^0.32.6",
    "redis": "^4.6.10",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.18",
    "@types/node": "^20.4.2",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/multer": "^1.4.7",
    "@types/bcryptjs": "^2.4.2",
